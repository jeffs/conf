{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "LSP",
      "WebFetch",
      "WebSearch",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "Bash(jj --version)",
      "Bash(jj bookmark list *)",
      "Bash(jj config get *)",
      "Bash(jj config list *)",
      "Bash(jj config path *)",
      "Bash(jj diff *)",
      "Bash(jj evolog *)",
      "Bash(jj file annotate *)",
      "Bash(jj file list *)",
      "Bash(jj file show *)",
      "Bash(jj git remote list *)",
      "Bash(jj help *)",
      "Bash(jj log *)",
      "Bash(jj op diff *)",
      "Bash(jj op log *)",
      "Bash(jj op show *)",
      "Bash(jj root *)",
      "Bash(jj show *)",
      "Bash(jj st *)",
      "Bash(jj status *)",
      "Bash(jj tag list *)",
      "Bash(jj workspace list *)",
      "Bash(jj workspace root *)"
    ],
    "deny": [
      "Read(~/.ssh/**)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeff/.cargo/bin/buddy hook SessionStart 2>/dev/null || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeff/.cargo/bin/buddy hook UserPromptSubmit 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeff/.cargo/bin/buddy hook PostToolUse 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeff/.cargo/bin/buddy hook PostToolUseFailure 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeff/.cargo/bin/buddy hook Stop 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jeff/.cargo/bin/buddy hook SessionEnd 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/jeff/.cargo/bin/buddy statusline",
    "padding": 0
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": false,
    "notion-workspace-plugin@notion-plugin-marketplace": false,
    "slack@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "notion-plugin-marketplace": {
      "source": {
        "source": "github",
        "repo": "makenotion/claude-code-notion-plugin"
      }
    }
  },
  "disabledMcpjsonServers": [
    "agentation"
  ],
  "cleanupPeriodDays": 365,
  "worktree": {
    "bgIsolation": "none"
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "fileCheckpointingEnabled": false,
  "agentPushNotifEnabled": true,
  "includeGitInstructions": false,
  "skillListingMaxDescChars": 700,
  "skillOverrides": {
    "dataviz": "user-invocable-only",
    "claude-api": "user-invocable-only",
    "artifact-capabilities": "user-invocable-only",
    "artifact-diagramming": "user-invocable-only",
    "schedule": "user-invocable-only",
    "loop": "user-invocable-only",
    "run": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "update-config": "name-only",
    "claude-in-chrome": "name-only",
    "code-review": "name-only",
    "simplify": "name-only"
  }
}
